<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>InSongLeaderboardSocket</AssemblyName>
    <RootNamespace>InSongLeaderboardSocket</RootNamespace>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
