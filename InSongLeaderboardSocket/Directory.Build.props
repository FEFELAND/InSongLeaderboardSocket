<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <PluginId>InSongLeaderboardSocket</PluginId>
    <PluginName>InSongLeaderboardSocket</PluginName>
    <Authors>FEFELAND</Authors>
    <Version>1.0.0</Version>
    <GameVersion>1.40.8</GameVersion>
    <Description>Real-time in-song leaderboard overlay for OBS via WebSocket (AI WAS USED)</Description>
    <BSMTProjectType>BSIPA</BSMTProjectType>
    <GenerateManifest>true</GenerateManifest>
  </PropertyGroup>

  <ItemGroup>
    <DependsOn Include="BSIPA" Version="^4.3.0" />
    <LoadAfter Include="BeatLeader" />
    <LoadAfter Include="ScoreSaber" />
  </ItemGroup>
</Project>
